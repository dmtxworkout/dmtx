# Neon Postgres connection string. Create a project at https://neon.tech and use
# a per-developer branch for local dev. Required for `pnpm db:migrate` / `db:studio`.
# The Neon HTTP driver cannot talk to a bare local Postgres — use a Neon branch.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"
