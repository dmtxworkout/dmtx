# ============================================================================
# DMTX — environment variable reference
# ============================================================================
# This is a REFERENCE of every var the project reads. Copy each value into the
# real file it belongs in (all gitignored):
#
#   apps/api/.dev.vars      → API secrets (loaded by `wrangler dev`)
#   packages/db/.env        → DATABASE_URL for drizzle-kit (migrations / studio)
#   apps/admin/.env.local   → NEXT_PUBLIC_API_URL for the admin app
#
# Non-secret API vars (BETTER_AUTH_URL, ADMIN_ORIGIN, EMAIL_FROM, R2_BUCKET)
# already have local defaults in apps/api/wrangler.toml — only override in prod.
#
# Minimum to run locally + do exercises CRUD:  DATABASE_URL + BETTER_AUTH_SECRET
# (R2 is only needed for media uploads; Resend only for auth emails.)
# ============================================================================


# --- 1) NEEDED NOW: Neon Postgres -------------------------------------------
# https://neon.tech — create a project, use a per-developer BRANCH.
# (The Neon HTTP driver can't talk to a bare local Postgres — use a Neon branch.)
# Put this in BOTH  apps/api/.dev.vars  AND  packages/db/.env
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"

# --- 2) NEEDED NOW: Better Auth secret --------------------------------------
# Any long random string. Generate one:  openssl rand -base64 32
# Put this in  apps/api/.dev.vars
BETTER_AUTH_SECRET="<run: openssl rand -base64 32>"


# --- 3) NEEDED for media uploads: Cloudflare R2 -----------------------------
# R2 → create bucket "dmtx-media" → Manage API Tokens → S3 access key + secret.
# Put these in  apps/api/.dev.vars
R2_ACCOUNT_ID="<cloudflare account id>"
R2_ACCESS_KEY_ID="<r2 access key id>"
R2_SECRET_ACCESS_KEY="<r2 secret access key>"
R2_PUBLIC_BASE_URL="https://media.dmtx.app"   # custom domain for reads (optional in dev)


# --- 4) NEEDED for auth emails: Resend --------------------------------------
# https://resend.com — verify a sending domain first (DNS can take up to 48h).
# Put this in  apps/api/.dev.vars   (email verification is OFF by default, so
# it's optional just to sign up / log in.)
RESEND_API_KEY="re_xxxxxxxx"


# --- 5) Admin app -----------------------------------------------------------
# Put this in  apps/admin/.env.local
NEXT_PUBLIC_API_URL="http://localhost:8787"


# --- Non-secret API vars (defaults live in apps/api/wrangler.toml) ----------
# Only set these to override for production.
BETTER_AUTH_URL="http://localhost:8787"        # API base URL (prod: https://api.dmtx.app)
ADMIN_ORIGIN="http://localhost:3001"           # CORS origin (prod: https://admin.dmtx.app)
EMAIL_FROM="DMTX <no-reply@dmtx.app>"
R2_BUCKET="dmtx-media"
# TRUSTED_ORIGINS="https://admin.dmtx.app"     # optional, comma-separated


# --- LATER: Stripe (self-managed billing phase) -----------------------------
# STRIPE_SECRET_KEY="sk_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
